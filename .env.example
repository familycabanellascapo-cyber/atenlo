# ── IA ──
# Clave de OpenAI. Sin ella, el chat funciona en "modo básico" (respuestas fijas, sin coste).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Base de datos (Supabase → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Secreta! Solo en el servidor (Vercel / .env.local). Nunca en el código.
SUPABASE_SERVICE_ROLE_KEY=

# ── Avisos de reserva por email (resend.com) ──
RESEND_API_KEY=
NOTIFY_FROM=ATENLO <avisos@atenlo.com>
